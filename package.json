{
  "name": "qidu-reader",
  "version": "1.7.0",
  "private": true,
  "description": "栖读 · 给阅读一个安静的空间",
  "author": "Qidu",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/assets.mjs && vite --host 127.0.0.1",
    "desktop": "electron .",
    "desktop:dev": "node scripts/dev.mjs",
    "build": "node scripts/assets.mjs && tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "dist": "pnpm build && node scripts/package.mjs",
    "pack": "pnpm build && node scripts/package.mjs --dir",
    "test:e2e": "pnpm build && node tests/e2e.mjs",
    "test:packaged": "node tests/packaged.mjs",
    "test:discovery": "pnpm build && node tests/discovery.mjs",
    "test:search-session": "pnpm build && node tests/search-session.mjs",
    "test:reading-upgrade": "pnpm build && node tests/reading-upgrade.mjs",
    "test:local-cache": "pnpm build && node tests/local-cache.mjs",
    "test:resources": "pnpm build && node tests/resources.mjs",
    "test:downloads": "pnpm build && node tests/downloads.mjs",
    "check:downloads": "node scripts/check-downloads.mjs",
    "test:new-sources": "pnpm build && node tests/new-sources.mjs",
    "check:sources": "node scripts/check-sources.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.3.0",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "marked": "^17.0.0",
    "pdfjs-dist": "^5.4.296",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^27.2.0",
    "pdf-lib": "^1.17.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "build": {
    "appId": "com.qidu.reader",
    "productName": "栖读",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Qidu-Reader-${version}-Windows.exe"
    }
  }
}
